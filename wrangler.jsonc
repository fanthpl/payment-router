/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "payment-router",
    "main": "src/index.ts",
    "compatibility_date": "2026-06-17",
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    "compatibility_flags": ["nodejs_compat"],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "payment-router",
            // Run `npx wrangler d1 create payment-router` and paste the id it prints here.
            "database_id": "3afa302b-cba5-4970-80c1-31cd73577a83",
            "migrations_dir": "./migrations"
        }
    ],
    "vars": {
        // Public origin of this worker, used to echo back the callback URLs you paste into the gateway.
        "PUBLIC_BASE_URL": "",
        // Set to "true" only for local testing against a webhook on localhost / plain http.
        "ALLOW_PRIVATE_WEBHOOK_TARGETS": "false",
        "FORWARD_TIMEOUT_MS": "10000"
    },
    "unsafe": {
        "bindings": [
            {
                "name": "ROUTES_RATE_LIMITER",
                "type": "ratelimit",
                // Unique id for this limiter within the account.
                "namespace_id": "1001",
                // At most 60 route creations per client IP per 60s window (period must be 10 or 60).
                "simple": { "limit": 60, "period": 60 }
            }
        ]
    }
}
