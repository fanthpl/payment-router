# Copy to `.dev.vars` for local `wrangler dev`. Do not commit the real `.dev.vars`.
# Ed25519 private key (JWK JSON) used to sign forwarded callbacks as EdDSA JWTs.
# Generate one with: node scripts/generate-signing-key.mjs
# In production set it with: wrangler secret put WEBHOOK_SIGNING_PRIVATE_KEY
WEBHOOK_SIGNING_PRIVATE_KEY='{"kty":"OKP","crv":"Ed25519","x":"...","d":"...","kid":"..."}'

# Optional, only during a key rotation: JSON array of retired PUBLIC JWKs to keep publishing in the
# JWKS until callbacks signed by the old key have expired.
# WEBHOOK_SIGNING_PUBLIC_KEYS='[{"kty":"OKP","crv":"Ed25519","x":"...","kid":"...","use":"sig","alg":"EdDSA"}]'
