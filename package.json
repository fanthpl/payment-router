	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"@types/node": "^25.9.3",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.8.4",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.101.0"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.8.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.29",
		"ipaddr.js": "^2.4.0",
		"zod": "^4.4.3"
	}
