{
	"name": "payment-router",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
